diff --git a/src/plugins/platforms/cocoa/qcocoaeglcontext.h b/src/plugins/platforms/cocoa/qcocoaeglcontext.h
new file mode 100644
index 00000000000..255b7e63548
--- /dev/null
+++ b/src/plugins/platforms/cocoa/qcocoaeglcontext.h
@@ -0,0 +1,36 @@
+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#ifndef QCOCOAEGLCONTEXT_H
+#define QCOCOAEGLCONTEXT_H
+
+#include <QtGui/private/qeglplatformcontext_p.h>
+#include <QtGui/private/qt_egl_p.h>
+
+QT_BEGIN_NAMESPACE
+
+class QCocoaWindow;
+
+// The OpenGL ES alternative to QCocoaGLContext. macOS has no system ES, so
+// this is always a third-party implementation - ANGLE, in practice, whose
+// Metal backend takes a CALayer as its EGLNativeWindowType and hangs a
+// CAMetalLayer off it. QCocoaWindow's content layer is exactly that.
+class QCocoaEGLContext : public QEGLPlatformContext
+{
+public:
+    explicit QCocoaEGLContext(QOpenGLContext *context);
+
+    // Shared across the plugin: one display, initialized on first use.
+    static EGLDisplay eglDisplay();
+
+protected:
+    EGLSurface eglSurfaceForPlatformSurface(QPlatformSurface *surface) override;
+};
+
+// Declared here so that qcocoawindow.mm can release the surface it owns
+// without pulling in the EGL headers.
+void qt_cocoaDestroyEglSurface(void *surface);
+
+QT_END_NAMESPACE
+
+#endif // QCOCOAEGLCONTEXT_H
diff --git a/src/plugins/platforms/cocoa/qcocoaeglcontext.mm b/src/plugins/platforms/cocoa/qcocoaeglcontext.mm
new file mode 100644
index 00000000000..6f7e3649ae3
--- /dev/null
+++ b/src/plugins/platforms/cocoa/qcocoaeglcontext.mm
@@ -0,0 +1,78 @@
+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#include "qcocoaeglcontext.h"
+#include "qcocoawindow.h"
+
+#include <QtGui/private/qeglpbuffer_p.h>
+
+#include <QtCore/qloggingcategory.h>
+
+QT_BEGIN_NAMESPACE
+
+Q_STATIC_LOGGING_CATEGORY(lcQpaCocoaEgl, "qt.qpa.cocoa.egl")
+
+EGLDisplay QCocoaEGLContext::eglDisplay()
+{
+    static EGLDisplay display = []() -> EGLDisplay {
+        EGLDisplay dpy = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+        if (dpy == EGL_NO_DISPLAY) {
+            qCWarning(lcQpaCocoaEgl, "No EGL display available");
+            return EGL_NO_DISPLAY;
+        }
+        EGLint major = 0;
+        EGLint minor = 0;
+        if (!eglInitialize(dpy, &major, &minor)) {
+            qCWarning(lcQpaCocoaEgl, "Could not initialize EGL: 0x%x", eglGetError());
+            return EGL_NO_DISPLAY;
+        }
+        qCDebug(lcQpaCocoaEgl, "EGL %d.%d initialized: %s (%s)", major, minor,
+                eglQueryString(dpy, EGL_VENDOR), eglQueryString(dpy, EGL_VERSION));
+        return dpy;
+    }();
+    return display;
+}
+
+QCocoaEGLContext::QCocoaEGLContext(QOpenGLContext *context)
+    : QEGLPlatformContext(context->format(), context->shareHandle(), eglDisplay())
+{
+}
+
+EGLSurface QCocoaEGLContext::eglSurfaceForPlatformSurface(QPlatformSurface *surface)
+{
+    if (surface->surface()->surfaceClass() != QSurface::Window)
+        return static_cast<QEGLPbuffer *>(surface)->pbuffer();
+
+    auto *window = static_cast<QCocoaWindow *>(surface);
+    if (window->m_eglSurface)
+        return static_cast<EGLSurface>(window->m_eglSurface);
+
+    CALayer *layer = window->contentLayer();
+    if (!layer) {
+        qCWarning(lcQpaCocoaEgl) << "No content layer to render into for" << window->window();
+        return EGL_NO_SURFACE;
+    }
+
+    // ANGLE's Metal backend checks the native window with -isKindOfClass and
+    // adds a CAMetalLayer of its own underneath it, resizing that along with
+    // the parent - so the surface survives window resizes and there is nothing
+    // to do on geometry changes.
+    EGLSurface eglSurface = eglCreateWindowSurface(eglDisplay(), eglConfig(),
+                                                   reinterpret_cast<EGLNativeWindowType>(layer),
+                                                   nullptr);
+    if (eglSurface == EGL_NO_SURFACE) {
+        qCWarning(lcQpaCocoaEgl, "Could not create the EGL window surface: 0x%x", eglGetError());
+        return EGL_NO_SURFACE;
+    }
+
+    window->m_eglSurface = eglSurface;
+    return eglSurface;
+}
+
+void qt_cocoaDestroyEglSurface(void *surface)
+{
+    if (surface)
+        eglDestroySurface(QCocoaEGLContext::eglDisplay(), static_cast<EGLSurface>(surface));
+}
+
+QT_END_NAMESPACE
