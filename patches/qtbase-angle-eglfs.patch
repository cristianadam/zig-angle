+#if defined(Q_OS_WIN)
+// eglfs has no window system to ask, so it owns the native window outright.
+// ANGLE takes an HWND as its EGLNativeWindowType, and a plain popup with
+// CS_OWNDC is all a single-surface-per-window platform needs.
+static const wchar_t *qt_eglfsWindowClass()
+{
+    static const wchar_t name[] = L"QtEglFSWindow";
+    static bool registered = false;
+    if (!registered) {
+        WNDCLASS wc = {};
+        wc.style = CS_OWNDC;
+        wc.lpfnWndProc = DefWindowProc;
+        wc.hInstance = GetModuleHandle(nullptr);
+        wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
+        wc.lpszClassName = name;
+        RegisterClass(&wc);
+        registered = true;
+    }
+    return name;
+}
+
+static HWND qt_eglfsCreateWindow(const QSize &size, bool visible)
+{
+    const int w = size.width() > 0 ? size.width() : 1;
+    const int h = size.height() > 0 ? size.height() : 1;
+    return CreateWindowEx(0, qt_eglfsWindowClass(), L"Qt",
+                          WS_POPUP | (visible ? WS_VISIBLE : 0),
+                          0, 0, w, h,
+                          nullptr, nullptr, GetModuleHandle(nullptr), nullptr);
+}
+#endif // Q_OS_WIN
