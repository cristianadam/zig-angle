diff --git a/src/plugins/platforms/eglfs/api/qeglfsnativewindow_mac.mm b/src/plugins/platforms/eglfs/api/qeglfsnativewindow_mac.mm
new file mode 100644
index 00000000000..b1ae588f3cf
--- /dev/null
+++ b/src/plugins/platforms/eglfs/api/qeglfsnativewindow_mac.mm
@@ -0,0 +1,32 @@
+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+// eglfs owns its native window outright, having no window system to ask. On
+// Apple that means a CALayer: ANGLE's Metal backend takes EGLNativeWindowType
+// as a void* and checks it with -isKindOfClass:[CALayer class].
+
+#include "qeglfsnativewindow_mac_p.h"
+
+#import <QuartzCore/CALayer.h>
+
+QT_BEGIN_NAMESPACE
+
+void *qt_eglfsCreateLayer(int width, int height)
+{
+    CALayer *layer = [[CALayer alloc] init];
+    layer.frame = CGRectMake(0, 0, width > 0 ? width : 1, height > 0 ? height : 1);
+    // No implicit animations: the layer is a render target, not part of a view
+    // hierarchy being laid out.
+    layer.actions = @{@"contents": [NSNull null], @"bounds": [NSNull null]};
+    return (__bridge_retained void *)layer;
+}
+
+void qt_eglfsDestroyLayer(void *nativeWindow)
+{
+    if (!nativeWindow)
+        return;
+    CALayer *layer = (__bridge_transfer CALayer *)nativeWindow;
+    (void)layer;
+}
+
+QT_END_NAMESPACE
