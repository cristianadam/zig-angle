diff --git a/src/plugins/platforms/windows/qwindowseglcontext.cpp b/src/plugins/platforms/windows/qwindowseglcontext.cpp
new file mode 100644
index 00000000000..343b3e614d5
--- /dev/null
+++ b/src/plugins/platforms/windows/qwindowseglcontext.cpp
@@ -0,0 +1,126 @@
+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#include "qwindowseglcontext.h"
+#include "qwindowscontext.h"
+#include "qwindowswindow.h"
+
+#include <QtGui/qopengl.h>
+#include <QtGui/qoffscreensurface.h>
+
+QT_BEGIN_NAMESPACE
+
+QWindowsEGLStaticContext::QWindowsEGLStaticContext(EGLDisplay display)
+    : m_display(display)
+{
+}
+
+QWindowsEGLStaticContext::~QWindowsEGLStaticContext()
+{
+    eglTerminate(m_display);
+}
+
+QWindowsEGLStaticContext *QWindowsEGLStaticContext::create()
+{
+    // ANGLE's WGL and D3D9 backends both want a real device context; the D3D11
+    // one does not care. Handing over the desktop DC suits all three, and
+    // EGL_DEFAULT_DISPLAY is only the fallback for the window system not being
+    // up yet.
+    EGLNativeDisplayType nativeDisplay = EGL_DEFAULT_DISPLAY;
+    if (const QWindowsContext *context = QWindowsContext::instance())
+        nativeDisplay = context->displayContext();
+
+    EGLDisplay display = eglGetDisplay(nativeDisplay);
+    if (display == EGL_NO_DISPLAY && nativeDisplay != EGL_DEFAULT_DISPLAY)
+        display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (display == EGL_NO_DISPLAY) {
+        qCWarning(lcQpaGl, "No EGL display available");
+        return nullptr;
+    }
+
+    EGLint major = 0;
+    EGLint minor = 0;
+    if (!eglInitialize(display, &major, &minor)) {
+        qCWarning(lcQpaGl, "Could not initialize EGL: 0x%x", eglGetError());
+        return nullptr;
+    }
+
+    qCDebug(lcQpaGl, "EGL %d.%d initialized: %s (%s)", major, minor,
+            eglQueryString(display, EGL_VENDOR), eglQueryString(display, EGL_VERSION));
+
+    return new QWindowsEGLStaticContext(display);
+}
+
+QPlatformOpenGLContext *QWindowsEGLStaticContext::createContext(QOpenGLContext *context)
+{
+    QPlatformOpenGLContext *share = context->shareHandle();
+    return new QWindowsEGLContext(this, context->format(), share);
+}
+
+QPlatformOpenGLContext *QWindowsEGLStaticContext::createContext(HGLRC context, HWND window)
+{
+    // An HGLRC is a WGL context; there is no such thing to adopt here. Callers
+    // check for null.
+    Q_UNUSED(context);
+    Q_UNUSED(window);
+    qCWarning(lcQpaGl, "Cannot adopt a WGL context in an OpenGL ES build");
+    return nullptr;
+}
+
+void *QWindowsEGLStaticContext::moduleHandle() const
+{
+    // QOpenGLContext::openGLModuleHandle() is meant to be the module the GL
+    // entry points live in, which here is the ES library rather than
+    // opengl32.dll. Ask for it by the address of one of its functions rather
+    // than by a name that varies between implementations.
+    HMODULE module = nullptr;
+    GetModuleHandleEx(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS
+                          | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                      reinterpret_cast<LPCTSTR>(&glGetString), &module);
+    return module;
+}
+
+void *QWindowsEGLStaticContext::createWindowSurface(void *nativeWindow, void *nativeConfig, int *err)
+{
+    if (err)
+        *err = 0;
+
+    EGLSurface surface = eglCreateWindowSurface(m_display,
+                                                static_cast<EGLConfig>(nativeConfig),
+                                                static_cast<EGLNativeWindowType>(nativeWindow),
+                                                nullptr);
+    if (surface == EGL_NO_SURFACE) {
+        const EGLint error = eglGetError();
+        if (err)
+            *err = error;
+        qCWarning(lcQpaGl, "Could not create the EGL window surface: 0x%x", error);
+        return nullptr;
+    }
+
+    return surface;
+}
+
+void QWindowsEGLStaticContext::destroyWindowSurface(void *nativeSurface)
+{
+    eglDestroySurface(m_display, static_cast<EGLSurface>(nativeSurface));
+}
+
+QWindowsEGLContext::QWindowsEGLContext(QWindowsEGLStaticContext *staticContext,
+                                       const QSurfaceFormat &format,
+                                       QPlatformOpenGLContext *share)
+    : QEGLPlatformContext(format, share, staticContext->display())
+{
+}
+
+EGLSurface QWindowsEGLContext::eglSurfaceForPlatformSurface(QPlatformSurface *surface)
+{
+    // QWindowsWindow caches the surface and destroys it from
+    // invalidateSurface() when the HWND goes away, so it has to be the one
+    // creating it - hence the detour through the static context.
+    auto *window = static_cast<QWindowsWindow *>(surface);
+    int err = 0;
+    void *nativeSurface = window->surface(eglConfig(), &err);
+    return static_cast<EGLSurface>(nativeSurface);
+}
+
+QT_END_NAMESPACE
