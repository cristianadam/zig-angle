@PACKAGE_INIT@

# Imported targets for a zig-angle install tree.
#
#   find_package(ANGLE REQUIRED)
#   target_link_libraries(app PRIVATE ANGLE::GLESv2 ANGLE::EGL)
#
# Hand-written rather than generated by install(EXPORT) on purpose: libGLESv2
# and libEGL link the ANGLE static library, zlib and (with Vulkan) SPIRV-Tools
# privately, and an exported target set would drag all of those into the
# package as $<LINK_ONLY:...> entries that consumers have no business seeing.
# The interface here is just the two shared libraries and the headers.

include(CMakeFindDependencyMacro)

set_and_check(ANGLE_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(ANGLE_BACKENDS "@ANGLE_ENABLED_BACKENDS@")
set(ANGLE_VERSION "@ANGLE_PACKAGE_VERSION@")

set(_angle_lib_dir "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
set(_angle_bin_dir "@PACKAGE_CMAKE_INSTALL_BINDIR@")

foreach (_angle_component GLESv2 EGL)
    if (TARGET ANGLE::${_angle_component})
        continue ()
    endif ()

    add_library(ANGLE::${_angle_component} SHARED IMPORTED)
    set_target_properties(ANGLE::${_angle_component} PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${ANGLE_INCLUDE_DIR}")

    if (WIN32)
        # The DLL is what loads; the import library is what links.
        set_target_properties(ANGLE::${_angle_component} PROPERTIES
            IMPORTED_LOCATION "${_angle_bin_dir}/lib${_angle_component}.dll"
            IMPORTED_IMPLIB   "${_angle_lib_dir}/lib${_angle_component}.dll.a")
    elseif (APPLE)
        set_target_properties(ANGLE::${_angle_component} PROPERTIES
            IMPORTED_LOCATION "${_angle_lib_dir}/lib${_angle_component}.dylib")
    else ()
        set_target_properties(ANGLE::${_angle_component} PROPERTIES
            IMPORTED_LOCATION "${_angle_lib_dir}/lib${_angle_component}.so")
    endif ()

    get_target_property(_angle_loc ANGLE::${_angle_component} IMPORTED_LOCATION)
    if (NOT EXISTS "${_angle_loc}")
        set(ANGLE_FOUND FALSE)
        set(ANGLE_NOT_FOUND_MESSAGE "ANGLE::${_angle_component} is missing: ${_angle_loc}")
        return ()
    endif ()
endforeach ()

# libEGL dispatches into libGLESv2, so anything linking EGL needs both.
set_property(TARGET ANGLE::EGL APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES ANGLE::GLESv2)

check_required_components(ANGLE)
