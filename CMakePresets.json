{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/dist/${presetName}",
      "toolchainFile": "${sourceDir}/toolchains/${presetName}.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "base",
      "description": "Needs a macOS SDK; set the ANGLE_MACOS_SDK environment variable or pass -DANGLE_MACOS_SDK=<path>."
    },
    {
      "name": "x86_64-linux-gnu",
      "inherits": "base",
      "displayName": "Linux x86_64 (glibc)"
    },
    {
      "name": "aarch64-linux-gnu",
      "inherits": "base",
      "displayName": "Linux arm64 (glibc)"
    },
    {
      "name": "x86_64-linux-musl",
      "inherits": "base",
      "displayName": "Linux x86_64 (musl)"
    },
    {
      "name": "aarch64-linux-musl",
      "inherits": "base",
      "displayName": "Linux arm64 (musl)"
    },
    {
      "name": "x86_64-windows-gnu",
      "inherits": "base",
      "displayName": "Windows x86_64"
    },
    {
      "name": "aarch64-windows-gnu",
      "inherits": "base",
      "displayName": "Windows arm64"
    },
    {
      "name": "x86-windows-gnu",
      "inherits": "base",
      "displayName": "Windows x86"
    },
    {
      "name": "x86_64-macos-none",
      "inherits": "macos-base",
      "displayName": "macOS x86_64"
    },
    {
      "name": "aarch64-macos-none",
      "inherits": "macos-base",
      "displayName": "macOS arm64"
    },
    {
      "name": "vulkan-base",
      "hidden": true,
      "description": "Vulkan needs an upstream ANGLE checkout with its deps synced; set ANGLE_SOURCE_DIR.",
      "cacheVariables": {
        "ANGLE_ENABLE_VULKAN": "ON"
      }
    },
    {
      "name": "x86_64-linux-gnu-vulkan",
      "inherits": [
        "x86_64-linux-gnu",
        "vulkan-base"
      ],
      "displayName": "Linux x86_64 (glibc) + Vulkan",
      "toolchainFile": "${sourceDir}/toolchains/x86_64-linux-gnu.cmake"
    },
    {
      "name": "aarch64-linux-gnu-vulkan",
      "inherits": [
        "aarch64-linux-gnu",
        "vulkan-base"
      ],
      "displayName": "Linux arm64 (glibc) + Vulkan",
      "toolchainFile": "${sourceDir}/toolchains/aarch64-linux-gnu.cmake"
    },
    {
      "name": "x86_64-linux-musl-vulkan",
      "inherits": [
        "x86_64-linux-musl",
        "vulkan-base"
      ],
      "displayName": "Linux x86_64 (musl) + Vulkan",
      "toolchainFile": "${sourceDir}/toolchains/x86_64-linux-musl.cmake"
    },
    {
      "name": "aarch64-linux-musl-vulkan",
      "inherits": [
        "aarch64-linux-musl",
        "vulkan-base"
      ],
      "displayName": "Linux arm64 (musl) + Vulkan",
      "toolchainFile": "${sourceDir}/toolchains/aarch64-linux-musl.cmake"
    },
    {
      "name": "x86_64-windows-gnu-vulkan",
